# ==================================================
#    Budget Meal Finder Environment Variables
# ==================================================

# This file provides an example of the environment variables
# required to run the application. Copy this file to a new
# file named .env and fill in the actual values.

# -----------------
# Server Settings
# -----------------

# The port the backend server will run on.
PORT=3000

# The application environment (e.g., 'development' or 'production')
NODE_ENV=development

# -----------------
# Database Settings
# -----------------

# Your MongoDB connection string.
MONGODB_URI=your_mongodb_connection_string_here

# -----------------
# Security Settings
# -----------------

# A secret key for signing JSON Web Tokens (JWT).
# Use a long, random, and secure string.
JWT_SECRET=your_jwt_secret_key

# -----------------
# External APIs
# -----------------

# Your Google Maps API Key for displaying maps on the frontend.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -----------------
# Admin Settings
# -----------------
ADMIN_REGISTRATION_SECRET=your_secret_code_here
